# SafeRoute AI Frontend - Local Testing Example
# Copy to .env and update API URLs based on your setup

# Backend API URL - Change based on your setup:
# Local: http://localhost:5000/api
# Emulator: http://10.0.2.2:5000/api (Android) or http://localhost:5000/api (iOS)
# Physical Device: http://YOUR_MACHINE_IP:5000/api
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Socket.io Server URL - Same as above without /api
# Local: http://localhost:5000
# Emulator: http://10.0.2.2:5000 (Android) or http://localhost:5000 (iOS)
# Physical Device: http://YOUR_MACHINE_IP:5000
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000

# OpenStreetMap Nominatim API (for place search)
# This is free and doesn't require authentication
EXPO_PUBLIC_NOMINATIM_API=https://nominatim.openstreetmap.org/search

# For production, change to your deployed backend URL
# EXPO_PUBLIC_API_URL=https://saferoute-api.onrender.com/api
# EXPO_PUBLIC_SOCKET_URL=https://saferoute-api.onrender.com
