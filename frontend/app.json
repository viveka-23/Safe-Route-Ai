{
  "expo": {
    "name": "SafeRoute AI",
    "slug": "saferoute-ai",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "package": "com.viveka09.saferouteai"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow SafeRoute AI to access your location information."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5bc1a214-79ef-48e6-a376-f5e391b8cb6d"
      }
    },
    "owner": "viveka09"
  }
}
