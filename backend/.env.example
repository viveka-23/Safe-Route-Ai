MONGODB_URI=
JWT_SECRET=
PORT=5000
NODE_ENV=development

# Mapbox API
MAPBOX_API_KEY=

# Graphhopper API (alternative to Mapbox)
GRAPHHOPPER_API_KEY=

# HuggingFace API
HUGGINGFACE_API_KEY=h
# Optional: specify a HF sentiment model to use for verification. The
# system will automatically fall back to a built-in list if the chosen
# model becomes unavailable (HTTP 410). Example:
# HUGGINGFACE_MODEL=distilbert-base-uncased-finetuned-sst-2-english

# You can disable AI verification completely if HF is unreachable or you
# just want all reports to be treated as verified. Set to 'false'.
# AI_VERIFICATION_ENABLED=true

# Frontend URL (for CORS)
FRONTEND_URL=http://192.168.53.221:8081
