# SafeRoute AI Backend - Local Testing Example
# Copy to .env and update with your actual credentials

# MongoDB Atlas Connection
# Get from: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=
# JWT Secret - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Server Port
PORT=5000

# Environment
NODE_ENV=development

# Graphhopper API Key (for routing)
# Get from: https://graphhopper.com
GRAPHHOPPER_API_KEY=

# Mapbox API Key (alternative routing)
# Get from: https://www.mapbox.com
MAPBOX_API_KEY=

# HuggingFace API Key (for AI verification)
# Get from: https://huggingface.co (Settings > Access Tokens)
HUGGINGFACE_API_KEY=

# Frontend URL (for CORS)
FRONTEND_URL=http://192.168.53.221:8081

# For production, change to your deployed frontend URL
# FRONTEND_URL=https://saferoute-ai.expo.dev
